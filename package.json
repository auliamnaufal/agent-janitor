{
  "name": "agent-janitor",
  "version": "0.2.0",
  "description": "Cross-agent guardian: inspect, classify, and safely reclaim what AI coding agents leave on your machine.",
  "type": "module",
  "bin": {
    "agent-janitor": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "dev": "node --watch --experimental-strip-types src/cli.ts",
    "start": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ai-agents",
    "agent",
    "claude-code",
    "codex",
    "cursor",
    "gemini",
    "disk-space",
    "cleanup",
    "garbage-collection",
    "secrets",
    "cli",
    "worktrees"
  ],
  "author": "auliamnaufal <auliamnaufal@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auliamnaufal/agent-janitor.git"
  },
  "homepage": "https://github.com/auliamnaufal/agent-janitor#readme",
  "bugs": {
    "url": "https://github.com/auliamnaufal/agent-janitor/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
